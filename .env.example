SECRET_KEY=sua-chave-secreta-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DATABASE_URL=
SENTRY_DSN=
ENVIRONMENT=development
RELEASE=local
SECURE_SSL_REDIRECT=False
USE_X_FORWARDED_HOST=False
TRUST_PROXY_SSL_HEADER=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
BOOTSTRAP_ADMIN=false
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PostgreSQL (produção)
# DATABASE_URL=postgres://user:password@host:5432/central_pet_db

# Cloudflare R2 — mídia persistente (produção)
# Ative somente depois de criar o bucket e configurar as credenciais.
R2_ENABLED=False
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Opcional: se vazio no código, usa https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# URL pública do bucket: domínio próprio recomendado em produção.
# Também aceita a URL r2.dev para testes. Pode informar com ou sem https://.
R2_PUBLIC_BASE_URL=

# WhatsApp padrão (sobrescreve o do admin se definido aqui)
# WHATSAPP_NUMBER=5561991083675
